<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="site-main">
    <div class="container">
        <div class="page-header d-flex justify-between align-center">
            <div>
                <h1 class="page-title">Manage Announcements</h1>
                <p class="page-subtitle">Publish news, academic deadlines, career notices, and campus advisories.</p>
            </div>
            <a href="/admin/announcements/new" class="btn btn-primary">+ New Announcement</a>
        </div>

        <%- include('../partials/flash') %>

        <div class="filter-card mb-4">
            <form action="/admin/announcements" method="GET" class="filter-form">
                <div class="filter-group">
                    <input type="text" name="search" class="form-control" placeholder="Search announcements..." value="<%= query.search || '' %>">
                </div>
                <div class="filter-group">
                    <select name="category" class="form-control">
                        <option value="ALL">All Categories</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="filter-group">
                    <select name="status" class="form-control">
                        <option value="ALL">All Statuses</option>
                        <% statuses.forEach(st => { %>
                            <option value="<%= st %>" <%= query.status === st ? 'selected' : '' %>><%= st %></option>
                        <% }) %>
                    </select>
                </div>
                <button type="submit" class="btn btn-secondary">Filter</button>
                <a href="/admin/announcements" class="btn btn-outline">Reset</a>
            </form>
        </div>

        <div class="card">
            <div class="card-body">
                <% if (announcements && announcements.length > 0) { %>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Published Date</th>
                                    <th>Author</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% announcements.forEach(a => { %>
                                    <tr>
                                        <td><strong><a href="/announcements/<%= a.id %>"><%= a.title %></a></strong></td>
                                        <td><span class="badge-category"><%= a.category %></span></td>
                                        <td><span class="badge-status badge-<%= a.status.toLowerCase() %>"><%= a.status %></span></td>
                                        <td><%= a.publishedAt ? new Date(a.publishedAt).toLocaleDateString() : 'Unpublished' %></td>
                                        <td><%= a.authorName || 'Admin' %></td>
                                        <td>
                                            <div class="table-actions">
                                                <a href="/admin/announcements/<%= a.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                                                <form action="/admin/announcements/<%= a.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this announcement?')">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-danger-outline btn-sm">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <%- include('../partials/pagination') %>
                <% } else { %>
                    <div class="empty-state py-5">
                        <p>No announcements found.</p>
                        <a href="/admin/announcements/new" class="btn btn-primary mt-2">Create First Announcement</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
