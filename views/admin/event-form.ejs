<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="site-main">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title"><%= isEdit ? 'Edit Event: ' + event.title : 'Create New Campus Event' %></h1>
            <p class="page-subtitle">Configure event capacity, registration deadlines, and schedule.</p>
        </div>

        <%- include('../partials/flash') %>

        <div class="card card-form">
            <div class="card-body">
                <form action="<%= isEdit ? '/admin/events/' + event.id + '/edit' : '/admin/events/new' %>" method="POST" novalidate>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">
                        <label for="title" class="form-label">Event Title *</label>
                        <input type="text" id="title" name="title" class="form-control" value="<%= event ? event.title : '' %>" required placeholder="e.g. Annual Tech Symposium 2026">
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Description & Agenda *</label>
                        <textarea id="description" name="description" class="form-control" rows="5" required placeholder="Detailed information about speakers, schedule, eligibility..."><%= event ? event.description : '' %></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="location" class="form-label">Location / Hall *</label>
                            <input type="text" id="location" name="location" class="form-control" value="<%= event ? event.location : '' %>" required placeholder="e.g. Main Auditorium / Online Zoom">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="capacity" class="form-label">Seat Capacity (Attendees) *</label>
                            <input type="number" id="capacity" name="capacity" class="form-control" value="<%= event ? event.capacity : 50 %>" min="1" required>
                            <small class="form-text text-muted">Once confirmed seats reach capacity, additional registrants are automatically placed on the waitlist.</small>
                        </div>
                    </div>

                    <% 
                        function toDatetimeLocal(d) {
                            if (!d) return '';
                            const date = new Date(d);
                            const pad = num => String(num).padStart(2, '0');
                            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
                        }
                    %>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="eventDate" class="form-label">Event Date & Time *</label>
                            <input type="datetime-local" id="eventDate" name="eventDate" class="form-control" value="<%= event ? toDatetimeLocal(event.eventDate) : '' %>" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="registrationDeadline" class="form-label">Registration Deadline *</label>
                            <input type="datetime-local" id="registrationDeadline" name="registrationDeadline" class="form-control" value="<%= event ? toDatetimeLocal(event.registrationDeadline) : '' %>" required>
                            <small class="form-text text-muted">Must be before the event date.</small>
                        </div>
                    </div>

                    <% if (isEdit) { %>
                        <div class="form-group">
                            <label for="status" class="form-label">Event Status</label>
                            <select id="status" name="status" class="form-control">
                                <option value="UPCOMING" <%= event.status === 'UPCOMING' ? 'selected' : '' %>>UPCOMING</option>
                                <option value="CANCELLED" <%= event.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
                                <option value="COMPLETED" <%= event.status === 'COMPLETED' ? 'selected' : '' %>>COMPLETED</option>
                            </select>
                        </div>
                    <% } %>

                    <div class="form-actions mt-4">
                        <button type="submit" class="btn btn-primary btn-lg"><%= isEdit ? 'Update Event' : 'Create Event' %></button>
                        <a href="/admin/events" class="btn btn-outline btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
