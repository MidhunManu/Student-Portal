<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="site-main">
    <div class="container">
        <div class="breadcrumb mb-3">
            <a href="/events">&larr; Back to Events</a>
        </div>

        <%- include('../partials/flash') %>

        <div class="detail-layout">
            <!-- Main Event Body -->
            <div class="detail-main">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-between align-center mb-3">
                            <span class="badge-status badge-<%= event.status.toLowerCase() %>"><%= event.status %></span>
                            <span class="text-sm text-muted">Created <%= new Date(event.createdAt).toLocaleDateString() %></span>
                        </div>

                        <h1 class="event-detail-title"><%= event.title %></h1>

                        <div class="event-meta-banner">
                            <div class="meta-banner-item">
                                <span class="banner-icon">📅</span>
                                <div>
                                    <span class="banner-label">Date & Time</span>
                                    <strong><%= new Date(event.eventDate).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
                                </div>
                            </div>
                            <div class="meta-banner-item">
                                <span class="banner-icon">📍</span>
                                <div>
                                    <span class="banner-label">Location</span>
                                    <strong><%= event.location %></strong>
                                </div>
                            </div>
                            <div class="meta-banner-item">
                                <span class="banner-icon">⏰</span>
                                <div>
                                    <span class="banner-label">Registration Closes</span>
                                    <strong><%= new Date(event.registrationDeadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
                                </div>
                            </div>
                        </div>

                        <div class="event-content-body mt-4">
                            <h3>About This Event</h3>
                            <p class="content-paragraph"><%= event.description %></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Registration Action Sidebar -->
            <div class="detail-sidebar">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Registration Status</h3>
                    </div>
                    <div class="card-body">
                        <!-- Capacity Progress Bar -->
                        <div class="capacity-box mb-4">
                            <div class="d-flex justify-between mb-1">
                                <span class="text-sm font-bold">Seats Reserved</span>
                                <span class="text-sm font-bold"><%= event.confirmedCount || 0 %> / <%= event.capacity %></span>
                            </div>
                            <% 
                                const pct = Math.min(100, Math.round(((event.confirmedCount || 0) / event.capacity) * 100));
                            %>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill <%= pct >= 100 ? 'fill-full' : '' %>" style="width: <%= pct %>%;"></div>
                            </div>
                            <% if ((event.waitlistedCount || 0) > 0) { %>
                                <p class="text-xs text-muted mt-2">
                                    ℹ️ <%= event.waitlistedCount %> attendee(s) currently on the waiting list.
                                </p>
                            <% } %>
                        </div>

                        <% if (!currentUser) { %>
                            <div class="alert alert-info">
                                <p class="m-0">Please sign in with your student or alumni account to register.</p>
                            </div>
                            <a href="/login" class="btn btn-primary btn-block btn-lg">Sign In to Register</a>
                        <% } else if (userRegistration && userRegistration.status !== 'CANCELLED') { %>
                            <!-- Already registered -->
                            <div class="user-reg-status-card mb-3 status-box-<%= userRegistration.status.toLowerCase() %>">
                                <h4>Registration Status</h4>
                                <span class="badge-status badge-<%= userRegistration.status.toLowerCase() %> badge-lg">
                                    <%= userRegistration.status %>
                                </span>
                                <% if (userRegistration.status === 'CONFIRMED') { %>
                                    <p class="text-sm mt-2">Your seat is reserved! We look forward to seeing you at the event.</p>
                                <% } else if (userRegistration.status === 'WAITLISTED') { %>
                                    <p class="text-sm mt-2">You are on the waitlist. If a confirmed attendee cancels, your registration will be automatically promoted.</p>
                                <% } %>
                            </div>

                            <form action="/events/<%= event.id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel your seat? This action cannot be undone.')">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-danger-outline btn-block">Cancel My Registration</button>
                            </form>
                        <% } else if (isClosed) { %>
                            <div class="alert alert-warning">
                                <p class="m-0">Registration for this event has closed.</p>
                            </div>
                            <button class="btn btn-disabled btn-block" disabled>Registration Closed</button>
                        <% } else { %>
                            <!-- Eligible to register -->
                            <% if (isFull) { %>
                                <div class="alert alert-warning mb-3">
                                    <p class="m-0"><strong>Event is at capacity.</strong> You will be placed on the waitlist and automatically promoted if a seat opens.</p>
                                </div>
                            <% } %>

                            <form action="/events/<%= event.id %>/register" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-primary btn-block btn-lg">
                                    <%= isFull ? 'Join Waitlist' : 'Reserve My Seat' %>
                                </button>
                            </form>
                        <% } %>

                        <% if (currentUser && currentUser.role === 'ADMIN') { %>
                            <div class="admin-actions-box mt-4 pt-3 border-top">
                                <span class="text-xs text-muted uppercase font-bold d-block mb-2">Admin Controls</span>
                                <a href="/admin/events/<%= event.id %>/edit" class="btn btn-outline btn-sm btn-block">Edit Event</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
