<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="site-main">
    <div class="container">
        <%- include('../partials/flash') %>

        <!-- Student Welcome Section -->
        <div class="dashboard-banner">
            <div class="banner-content">
                <span class="badge-role badge-role-student">Student Portal</span>
                <h1 class="dashboard-greeting">Welcome, <%= student.name %></h1>
                <p class="dashboard-subtext">Access campus events, monitor your registration status, and connect with college alumni.</p>
            </div>
            <div class="banner-stats">
                <div class="stat-box">
                    <span class="stat-box-num"><%= data.confirmedCount %></span>
                    <span class="stat-box-label">Confirmed Seats</span>
                </div>
                <div class="stat-box">
                    <span class="stat-box-num"><%= data.waitlistedCount %></span>
                    <span class="stat-box-label">Waitlisted</span>
                </div>
            </div>
        </div>

        <!-- Dashboard Grid -->
        <div class="dashboard-grid">
            <!-- Left Column: My Registrations Summary & Events -->
            <div class="dashboard-main-col">
                <!-- Upcoming Campus Events -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-between align-center">
                        <h2 class="card-title">Featured Campus Events</h2>
                        <a href="/events" class="btn btn-outline btn-sm">Explore All Events</a>
                    </div>
                    <div class="card-body">
                        <% if (data.upcomingEvents && data.upcomingEvents.length > 0) { %>
                            <div class="event-mini-list">
                                <% data.upcomingEvents.forEach(evt => { %>
                                    <div class="event-mini-card">
                                        <div class="event-mini-date">
                                            <span class="mini-month"><%= new Date(evt.eventDate).toLocaleDateString('en-US', { month: 'short' }) %></span>
                                            <span class="mini-day"><%= new Date(evt.eventDate).getDate() %></span>
                                        </div>
                                        <div class="event-mini-info">
                                            <h4><a href="/events/<%= evt.id %>"><%= evt.title %></a></h4>
                                            <p class="text-muted">📍 <%= evt.location %> &bull; Deadline: <%= new Date(evt.registrationDeadline).toLocaleDateString() %></p>
                                        </div>
                                        <div class="event-mini-action">
                                            <a href="/events/<%= evt.id %>" class="btn btn-primary btn-sm">View Details</a>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No upcoming events at this moment.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Recent Registrations Preview -->
                <div class="card">
                    <div class="card-header d-flex justify-between align-center">
                        <h2 class="card-title">My Recent Registrations</h2>
                        <a href="/student/registrations" class="btn btn-outline btn-sm">View All Registrations</a>
                    </div>
                    <div class="card-body">
                        <% if (data.registrations && data.registrations.length > 0) { %>
                            <div class="table-responsive">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Event</th>
                                            <th>Event Date</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% data.registrations.slice(0, 5).forEach(reg => { %>
                                            <tr>
                                                <td><strong><%= reg.eventTitle %></strong></td>
                                                <td><%= reg.eventDate ? new Date(reg.eventDate).toLocaleDateString() : 'N/A' %></td>
                                                <td>
                                                    <span class="badge-status badge-<%= reg.status.toLowerCase() %>">
                                                        <%= reg.status %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="/events/<%= reg.eventId %>" class="btn btn-outline btn-sm">Details</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <p>You haven't registered for any events yet.</p>
                                <a href="/events" class="btn btn-primary btn-sm mt-2">Browse Events</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right Column: Announcements & Quick Shortcuts -->
            <div class="dashboard-side-col">
                <div class="card mb-4">
                    <div class="card-header">
                        <h2 class="card-title">Quick Actions</h2>
                    </div>
                    <div class="card-body">
                        <ul class="quick-links-list">
                            <li><a href="/events">📅 Browse & Register for Events</a></li>
                            <li><a href="/student/registrations">📋 Check My Waitlist / Registrations</a></li>
                            <li><a href="/alumni">🎓 Search Alumni Directory</a></li>
                            <li><a href="/jobs">💼 Discover Career & Job Posts</a></li>
                            <li><a href="/announcements">📢 Campus Announcements</a></li>
                        </ul>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-between align-center">
                        <h2 class="card-title">Latest Announcements</h2>
                        <a href="/announcements" class="text-sm">View All</a>
                    </div>
                    <div class="card-body">
                        <% if (data.announcements && data.announcements.length > 0) { %>
                            <div class="announcement-mini-list">
                                <% data.announcements.forEach(a => { %>
                                    <div class="announcement-mini-item">
                                        <span class="badge-category badge-sm"><%= a.category %></span>
                                        <h5><a href="/announcements/<%= a.id %>"><%= a.title %></a></h5>
                                        <p class="text-muted text-xs"><%= new Date(a.publishedAt || a.createdAt).toLocaleDateString() %></p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted text-sm">No new announcements today.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
