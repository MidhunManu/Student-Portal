<% 
    const user = typeof currentUser !== 'undefined' ? currentUser : null;
    const path = typeof currentPath !== 'undefined' ? currentPath : '';
    const token = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>
<header class="main-header">
    <div class="nav-container">
        <a href="/" class="brand-logo">
            <span class="brand-crest">🏛️</span>
            <span class="brand-text">Apex <strong>Portal</strong></span>
        </a>

        <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="main-nav" id="mainNav">
            <ul class="nav-links">
                <% if (!user) { %>
                    <li><a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a></li>
                    <li><a href="/events" class="<%= path.startsWith('/events') ? 'active' : '' %>">Events</a></li>
                    <li><a href="/announcements" class="<%= path.startsWith('/announcements') ? 'active' : '' %>">Announcements</a></li>
                    <li><a href="/jobs" class="<%= path.startsWith('/jobs') ? 'active' : '' %>">Jobs</a></li>
                    <li><a href="/alumni" class="<%= path.startsWith('/alumni') || path.startsWith('/directory') ? 'active' : '' %>">Alumni</a></li>
                <% } else if (user.role === 'STUDENT') { %>
                    <li><a href="/student/dashboard" class="<%= path === '/student/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                    <li><a href="/events" class="<%= path.startsWith('/events') ? 'active' : '' %>">Campus Events</a></li>
                    <li><a href="/student/registrations" class="<%= path === '/student/registrations' ? 'active' : '' %>">My Registrations</a></li>
                    <li><a href="/alumni" class="<%= path.startsWith('/alumni') || path.startsWith('/directory') ? 'active' : '' %>">Alumni Directory</a></li>
                    <li><a href="/announcements" class="<%= path.startsWith('/announcements') ? 'active' : '' %>">Announcements</a></li>
                    <li><a href="/jobs" class="<%= path.startsWith('/jobs') ? 'active' : '' %>">Jobs</a></li>
                <% } else if (user.role === 'ALUMNI') { %>
                    <li><a href="/alumni/dashboard" class="<%= path === '/alumni/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                    <li><a href="/alumni/profile" class="<%= path === '/alumni/profile' ? 'active' : '' %>">My Profile</a></li>
                    <li><a href="/alumni/connections" class="<%= path === '/alumni/connections' ? 'active' : '' %>">Connections</a></li>
                    <li><a href="/alumni" class="<%= path === '/alumni' ? 'active' : '' %>">Directory</a></li>
                    <li><a href="/jobs" class="<%= path === '/jobs' ? 'active' : '' %>">Jobs</a></li>
                    <li><a href="/jobs/my" class="<%= path === '/jobs/my' ? 'active' : '' %>">My Posts</a></li>
                    <li><a href="/events" class="<%= path.startsWith('/events') ? 'active' : '' %>">Events</a></li>
                    <li><a href="/announcements" class="<%= path.startsWith('/announcements') ? 'active' : '' %>">Announcements</a></li>
                <% } else if (user.role === 'ADMIN') { %>
                    <li><a href="/admin/dashboard" class="<%= path === '/admin/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                    <li><a href="/admin/events" class="<%= path.startsWith('/admin/events') ? 'active' : '' %>">Manage Events</a></li>
                    <li><a href="/admin/announcements" class="<%= path.startsWith('/admin/announcements') ? 'active' : '' %>">Announcements</a></li>
                    <li><a href="/admin/jobs" class="<%= path.startsWith('/admin/jobs') ? 'active' : '' %>">Jobs</a></li>
                    <li><a href="/admin/users" class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">Users & Roles</a></li>
                <% } %>
            </ul>

            <div class="nav-auth">
                <% if (!user) { %>
                    <a href="/login" class="btn btn-outline-nav">Sign In</a>
                    <a href="/register" class="btn btn-primary-nav">Register</a>
                <% } else { %>
                    <div class="user-greeting">
                        <span class="user-name"><%= user.name %></span>
                        <span class="badge-role badge-role-<%= user.role.toLowerCase() %>"><%= user.role %></span>
                    </div>
                    <form action="/logout" method="POST" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= token %>">
                        <button type="submit" class="btn btn-outline-nav btn-sm">Logout</button>
                    </form>
                <% } %>
            </div>
        </nav>
    </div>
</header>
