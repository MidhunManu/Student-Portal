# Application Environment Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=portal

# Authentication & Session Secrets (Use a 32+ character random string in production)
SESSION_SECRET=replace_with_secure_random_session_secret_min_32_chars
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars

# Logging
LOG_LEVEL=info
